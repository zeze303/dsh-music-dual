{
  "name": "@dsh-external/dsh-music-dual",
  "version": "0.1.0",
  "description": "双平台音乐播放器 DeepSeek Harness 插件：网易云音乐 + QQ 音乐，悬浮可拖动毛玻璃播放器，支持搜索、歌单导入、登录态解锁（DSH_MUSIC_COOKIE / DSH_MUSIC_QQ_COOKIE），以及 agent 侧的 music 工具。dsh-music-dual: a dual-platform (NetEase Cloud Music + QQ Music) floating music player plugin for DeepSeek Harness.",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeze303/dsh-music-dual.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dependencies": {
    "NeteaseCloudMusicApi": "^4.32.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT"
}
